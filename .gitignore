# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Секреты ─────────────────────────────────────────────────────────────────
# Шаблон без значений — .env.example — коммитится и лежит рядом.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
*.p12
*.pfx

# ── Кэш приложения ──────────────────────────────────────────────────────────
# Разобранные шаблоны и распакованные шрифты: восстанавливаются из шаблона.
.cache/

# ── Артефакты прогонов ──────────────────────────────────────────────────────
# Колоды, PDF, скриншоты и манифесты. Финальные демо добавляются принудительно:
#   git add -f outputs/demo/...
outputs/*
!outputs/.gitkeep
!outputs/demo/

# Рабочие каталоги скриптов проверки живого прогона (scripts/probe_*.py|sh).
out/
# Каталог разовых сверок и замеров: отладочные скрипты в исходниках не живут.
.repair-progress/

# ── Журналы, временное, базы ────────────────────────────────────────────────
*.log
logs/
tmp/
*.tmp
*.bak
*.db
*.sqlite
*.sqlite3
*.sql.gz
*.dump

# ── Редакторы и ОС ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# ── Офисные замки ───────────────────────────────────────────────────────────
# PowerPoint и Word держат рядом с открытым файлом скрытый ~$-замок.
~$*
