# Скопируйте в .env и заполните. .env в репозиторий не коммитится.
# Ключи в config.yaml не пишутся — там только ссылки ${VAR}.
#
# Файл читает само приложение (`deckwright.config.load_env_file`): ни `source`,
# ни docker-compose для этого не нужны. Ищется он в корне проекта независимо
# от того, из какого каталога запущен процесс; другой путь задаётся
# переменной DECKWRIGHT_ENV_FILE.
#
# Приоритет: переменная, уже заданная в окружении, СИЛЬНЕЕ этого файла.
# Поэтому `LLM_API_KEY=... deckwright run` перекрывает .env, а не наоборот.

# ── LLM: OpenAI-совместимый endpoint ────────────────────────────────────────
# Разработка: SiliconFlow. Финал: инференс VK — меняются только эти три строки.
# Внимание: у SiliconFlow два независимых сервиса — .com и .cn. Аккаунты и
# ключи у них разные, ключ одного на другом отвечает "Token is invalid".
LLM_BASE_URL=https://api.siliconflow.com/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.6-27B

# ── VLM: контекстный аудит по картинке слайда ───────────────────────────────
# Может быть тот же endpoint и тот же ключ, что у LLM.
VLM_BASE_URL=https://api.siliconflow.com/v1
VLM_API_KEY=
VLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# ── text-to-image: задача со звёздочкой, по умолчанию выключено ─────────────
T2I_BASE_URL=
T2I_API_KEY=
T2I_MODEL=

# ── libeot: распаковка встроенных в шаблон шрифтов ──────────────────────────
# Обычно не нужна: имя файла библиотеки приложение подбирает само
# (`libeot.so.0` в Linux, `libeot.0.dylib` в macOS). Переменная нужна там, где
# библиотека лежит вне путей линковщика — например, собрана из исходников:
# формулы libeot в Homebrew нет, и с LibreOffice для macOS она не приезжает.
# Без неё шрифт шаблона не извлекается, текст меряется по подставленному, и
# это пишется в манифест прогона. `deckwright doctor` показывает, что нашлось.
DECKWRIGHT_LIBEOT=

# ── Веб-интерфейс ───────────────────────────────────────────────────────────
# Пароль на вход. Обязателен для публичного адреса: каждый прогон тратит
# ключ модели. Пусто — вход открыт (локальный запуск).
DECKWRIGHT_PASSWORD=

# ── Тесты ───────────────────────────────────────────────────────────────────
# Каталог с .pptx, на которых гоняются тесты разбора шаблонов. По умолчанию
# берётся `data/templates/`; без этой переменной и без каталога такие тесты
# пропускаются (`tests/conftest.py`), остальные идут как обычно.
DECKWRIGHT_TEMPLATES=data/templates
